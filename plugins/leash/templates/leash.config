# leash.config · your agent's rules for paying people.
# Lives in your repo, next to your code. The agent can't read it or change it:
# a PreToolUse hook checks every leash_pay against it before anything moves.
# Edit it yourself, then approve the new version with the pin command /leash:setup prints.

[limits]
per_job_usd = 300      # never more than this in one payment (network cap: 1000)
per_day_usd = 500      # never more than this in 24 h, all payments together (network cap: 5000)
max_fee_bps = 200      # runner fee cap: 200 = 2% (network cap: 5%)

# One [[allow]] block per person your agent may pay without asking you.
# to:      their handle, email, phone or IBAN on that app, exactly as you'd type it
# rail:    paypal, zelle, venmo, cashapp, revolut, wise, applecash, googlepay, sepa, bank_us, ...
# max_usd: the most it can pay them, per payment or per `every` (job, day, week, month)

# [[allow]]
# name    = "designer"
# to      = "maya@studio.design"
# rail    = "paypal"
# max_usd = 300
# every   = "month"

[default]
unknown_recipient = "ask"     # someone with no rule: "ask" you, or "block"
from_untrusted    = "block"   # a recipient you never typed (it came from an issue, PR, web page): "ask" or "block"
over_limit        = "block"   # a known recipient, but too much: "ask" or "block"
